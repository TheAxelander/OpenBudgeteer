<MudStack Row StretchItems="StretchItems.End">
    <MudImage Src="@ImageUrl" ObjectFit="ObjectFit.ScaleDown" ObjectPosition="ObjectPosition.Center"/>
    <MudPaper Class="no-background" Elevation="0">
        <MudText Align="Align.Center" Style="font-weight: bold">@Title</MudText>
        <MudDivider Class="my-1"/>
        <MudText Align="Align.Center" Style="@GetBalanceColor(Amount)">@Amount</MudText>
    </MudPaper>
</MudStack>

@code {
    [Parameter] 
    public string? ImageUrl { get; set; }

    [Parameter] 
    public string? Title { get; set; }

    [Parameter] 
    public string? Amount { get; set; }

    // Determines the color style for the balance text based on its value.
    private string GetBalanceColor(string balance)
    {
        var amount = decimal.Parse(System.Text.RegularExpressions.Regex.Replace(balance, @"[^\d.-]", ""));

        if (amount == 0)
            return string.Empty;

        return amount < 0 ? "color: red;" : "color: green;";
    }
}