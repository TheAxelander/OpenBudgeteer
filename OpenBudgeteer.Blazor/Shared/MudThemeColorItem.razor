@*
Source: https://github.com/MudBlazor/ThemeManager
*@
@using MudBlazor.Utilities

<MudOverlay @bind-Visible="_isOpen"
            AutoClose="true"/>

<div class="relative">
    <div @onclick="() => _isOpen = !_isOpen"
         class="mud-list-item-clickable mud-ripple px-4 py-3">
        <MudText Class="mud-float-left"
                 Typo="Typo.body2">
            @Name
        </MudText>
        <div class="px-8 py-3 mud-float-right rounded mud-elevation-25"
             style="background:@(Value?.ToString() ?? "none");"></div>
    </div>
    <MudPopover AnchorOrigin="Origin.BottomCenter"
                Elevation="25"
                Open="@_isOpen"
                Square="true"
                TransformOrigin="Origin.TopCenter">
        <MudColorPicker ValueChanged="OnColorSelected"
                        Class="mud-thememanager-color-picker"
                        ColorPickerView="ColorPickerView"
                        Elevation="0"
                        PickerVariant="PickerVariant.Static"
                        Value="Value"/>
    </MudPopover>
</div>


@code {
    private bool _isOpen;

    [Parameter]
    public string? Name { get; set; }

    [Parameter]
    public MudColor? Value { get; set; }

    [Parameter]
    public EventCallback<MudColor?> ValueChanged { get; set; }

    [Parameter]
    public ColorPickerView ColorPickerView { get; set; } = ColorPickerView.Spectrum;

    private async Task OnColorSelected(MudColor? value)
    {
        Value = value;
        await ValueChanged.InvokeAsync(value);
    }
}
