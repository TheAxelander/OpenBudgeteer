@using OpenBudgeteer.Core.Common
@using OpenBudgeteer.Core.ViewModels.Helper
@using System.Globalization

<MudStack AlignItems="AlignItems.Center"
          Row
          Spacing="2">

    <!-- Previous Button -->
    <MudIconButton OnClick="DataContext.PreviousMonth"
                   Color="Color.Primary"
                   Icon="@Icons.Material.Filled.NavigateBefore"
                   Size="Size.Small"
                   Variant="Variant.Outlined"></MudIconButton>

    <!-- Month Selector -->
    <MudSelect T="int"
               @bind-Value="DataContext.SelectedMonth"
               Style="width: 80px">
        @foreach (var month in DataContext.Months)
        {
            <MudSelectItem Value="@month">
                @_monthConverter.ConvertMonth(month, CultureInfo.CurrentCulture)
            </MudSelectItem>
        }
    </MudSelect>

    <!-- Year input field -->
    <MudNumericField T="int"
                     @bind-Value="@DataContext.SelectedYear"
                     Style="text-align: right; width: 80px"/>

    <!-- Next Button -->
    <MudIconButton OnClick="DataContext.NextMonth"
                   Color="Color.Primary"
                   Icon="@Icons.Material.Filled.NavigateNext"
                   Size="Size.Small"
                   Variant="Variant.Outlined"></MudIconButton>
</MudStack>

@code {
    [Parameter]
    public YearMonthSelectorViewModel DataContext { get; set; } = null!;

    [Parameter]
    public string? Class { get; set; }

    readonly MonthOutputConverter _monthConverter = new();
}
