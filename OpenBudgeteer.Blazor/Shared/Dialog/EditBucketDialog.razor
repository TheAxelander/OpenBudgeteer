@using System.Drawing
@using OpenBudgeteer.Core.Common.Extensions
@using OpenBudgeteer.Core.Data.Entities.Models
@using OpenBudgeteer.Core.ViewModels.EntityViewModels
@using Color = MudBlazor.Color
@using Size = MudBlazor.Size

<MudDialog Class="dialog-background">
    <TitleContent>
        <MudText Typo="Typo.h6">@Title</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid Spacing="4">

            <!-- Name -->
            <MudItem xs="12"
                     sm="6">
                <MudTextField @bind-Value="DataContext.Name"
                              Label="Name:"/>
            </MudItem>

            <!-- Bucket Group -->
            <MudItem xs="12"
                     sm="6">
                <MudSelect T="BucketGroup"
                           @bind-Value="DataContext.SelectedBucketGroup"
                           Label="Bucket Group:"
                           ToStringFunc="@_convertBucketGroup">
                    @foreach (var bucketGroup in DataContext.AvailableBucketGroups!)
                    {
                        <MudSelectItem Value="@bucketGroup">@bucketGroup.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <!-- Bucket Type -->
            <MudItem xs="12"
                     sm="6">
                <MudSelect T="BucketVersionViewModel.BucketType"
                           ValueChanged="BucketType_SelectionChanged"
                           Label="Bucket Type:"
                           ToStringFunc="@_convertBucketType"
                           Value="DataContext.BucketVersion.BucketTypeParameter">
                    @foreach (var bucketType in Enum.GetValues(typeof(BucketVersionViewModel.BucketType)))
                    {
                        <MudSelectItem Value="@((BucketVersionViewModel.BucketType)bucketType)">@(((BucketVersionViewModel.BucketType)bucketType).GetStringValue())</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <!-- Number of months -->
            <MudItem xs="12"
                     sm="6">
                <MudNumericField T="int"
                                 @bind-Value="DataContext.BucketVersion.BucketTypeIntParameter"
                                 Disabled="@(!_isNumberOfMonthsEnabled)"
                                 Label="Number of months:"/>
            </MudItem>

            <!-- Amount -->
            <MudItem xs="12"
                     sm="6">
                <MudNumericField T="decimal"
                                 @bind-Value="DataContext.BucketVersion.BucketTypeDecimalParameter"
                                 Disabled="@(!_isAmountEnabled)"
                                 Format="N2"
                                 Label="Amount:"/>
            </MudItem>

            <!-- (First) Target Date -->
            <MudItem xs="12"
                     sm="6">
                <MudDatePicker DateChanged="@(time => TransactionDateChanged(time))"
                               Date="@(DataContext.BucketVersion.BucketTypeDateParameter.ToDateTime(TimeOnly.MinValue))"
                               Disabled="@(!_isTargetDateEnabled)"
                               Label="(First) Target Date:"/>
                @if (_isTargetDateEnabled)
                {
                    <MudText Typo="Typo.body2">Next applying
                        date: @DataContext.BucketVersion.BucketTypeNextDateParameter.ToShortDateString()</MudText>
                }
            </MudItem>

            <!-- Background Color -->
            <MudItem xs="12"
                     sm="6">
                <MudSelect T="string"
                           @bind-Value="DataContext.ColorCode"
                           Label="Background Color:">
                    @foreach (var color in DataContext.AvailableColors!)
                    {
                        <MudSelectItem Value="@color.Name">@color.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <!-- Text Color -->
            <MudItem xs="12"
                     sm="6">
                <MudSelect T="string"
                           @bind-Value="DataContext.TextColorCode"
                           Label="Text Color:">
                    @foreach (var color in DataContext.AvailableColors!)
                    {
                        <MudSelectItem Value="@color.Name">@color.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <!-- Additional options -->
            <MudItem xs="12">
                <MudCheckBox T="bool"
                             @bind-Value="DataContext.IsHiddenFromSummaries"
                             Label="Hide assigned Transactions from Summaries and Statistics">
                </MudCheckBox>
            </MudItem>

            <!-- Preview -->
            <MudItem xs="12">
                <MudText Typo="Typo.subtitle1">Preview:</MudText>
                <MudPaper Class="d-flex align-center justify-center mud-width-full bucket-indicator no-background"
                          Style="@($"background-color: {ColorTranslator.ToHtml(DataContext.Color)}; color: {ColorTranslator.ToHtml(DataContext.TextColor)}")">
                    <MudText>@DataContext.Name</MudText>
                </MudPaper>
            </MudItem>

            <!-- Notes -->
            <MudItem xs="12">
                <MudTextField @bind-Value="DataContext.BucketVersion.Notes"
                              Label="Notes:"
                              Lines="5"/>
            </MudItem>

            <!-- Explanation -->
            <MudItem xs="12">
                <MudAlert Dense="true"
                          Severity="Severity.Info"
                          Variant="Variant.Outlined">
                    @(DataContext.BucketId == Guid.Empty
                        ? "Bucket will be valid from the currently selected month."
                        : "Changes will apply from the currently selected month.")
                </MudAlert>
            </MudItem>

        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="ConfirmSave"
                   Color="Color.Primary"
                   Size="Size.Small"
                   Variant="Variant.Filled">
            Save
        </MudButton>
        <MudButton OnClick="ConfirmCancel"
                   Color="Color.Error"
                   Size="Size.Small"
                   Variant="Variant.Filled">
            Cancel
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public BucketViewModel DataContext { get; set; } = null!;

    [Parameter]
    public bool IsDialogVisible { get; set; }

    [Parameter]
    public EventCallback<MouseEventArgs> OnCancelClickCallback { get; set; }

    [Parameter]
    public EventCallback<MouseEventArgs> OnSaveClickCallback { get; set; }

    private bool _isNumberOfMonthsEnabled = true;
    private bool _isAmountEnabled = true;
    private bool _isTargetDateEnabled = true;

    private readonly Func<BucketGroup, string> _convertBucketGroup = x =>
    {
        try
        {
            return x.Name ?? string.Empty;
        }
        catch (Exception)
        {
            return string.Empty;
        }
    };

    private readonly Func<BucketVersionViewModel.BucketType, string> _convertBucketType = x =>
    {
        try
        {
            return x.GetStringValue();
        }
        catch (Exception)
        {
            return string.Empty;
        }
    };

    private void ConfirmSave() => MudDialog.Close(DialogResult.Ok(true));

    private void ConfirmCancel() => MudDialog.Cancel();

    protected override Task OnParametersSetAsync()
    {
        UpdateInputFieldsState();
        return base.OnParametersSetAsync();
    }

    void BucketType_SelectionChanged(BucketVersionViewModel.BucketType bucketType)
    {
        DataContext.BucketVersion.BucketTypeParameter = bucketType;
        UpdateInputFieldsState();
    }

    void TransactionDateChanged(DateTime? dateTime)
    {
        DataContext.BucketVersion.BucketTypeDateParameter = DateOnly.FromDateTime(dateTime ?? DateTime.Today);
    }

    void UpdateInputFieldsState()
    {
        switch (DataContext.BucketVersion.BucketTypeParameter)
        {
            case BucketVersionViewModel.BucketType.StandardBucket:
                _isNumberOfMonthsEnabled = false;
                _isAmountEnabled = false;
                _isTargetDateEnabled = false;
                DataContext.BucketVersion.BucketTypeDateParameter = DateOnly.MinValue;
                break;
            case BucketVersionViewModel.BucketType.MonthlyExpense:
                _isNumberOfMonthsEnabled = false;
                _isAmountEnabled = true;
                _isTargetDateEnabled = false;
                DataContext.BucketVersion.BucketTypeDateParameter = DateOnly.MinValue;
                break;
            case BucketVersionViewModel.BucketType.ExpenseEveryXMonths:
                _isNumberOfMonthsEnabled = true;
                _isAmountEnabled = true;
                _isTargetDateEnabled = true;
                if (DataContext.BucketVersion.BucketTypeDateParameter == DateOnly.MinValue)
                    DataContext.BucketVersion.BucketTypeDateParameter = DateOnly.FromDateTime(DateTime.Now);
                break;
            case BucketVersionViewModel.BucketType.SaveXUntilYDate:
                _isNumberOfMonthsEnabled = false;
                _isAmountEnabled = true;
                _isTargetDateEnabled = true;
                if (DataContext.BucketVersion.BucketTypeDateParameter == DateOnly.MinValue)
                    DataContext.BucketVersion.BucketTypeDateParameter = DateOnly.FromDateTime(DateTime.Now);
                break;
            default:
                _isNumberOfMonthsEnabled = true;
                _isAmountEnabled = true;
                _isTargetDateEnabled = true;
                if (DataContext.BucketVersion.BucketTypeDateParameter == DateOnly.MinValue)
                    DataContext.BucketVersion.BucketTypeDateParameter = DateOnly.FromDateTime(DateTime.Now);
                break;
        }
    }
}
