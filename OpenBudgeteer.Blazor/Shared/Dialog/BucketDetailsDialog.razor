@using ApexCharts
@using OpenBudgeteer.Blazor.Common
@using OpenBudgeteer.Blazor.ViewModels
@using System.Globalization
@using OpenBudgeteer.Blazor.Common.CustomMudFilter
@using OpenBudgeteer.Blazor.Common.Extensions
@using OpenBudgeteer.Core.Common.AppSettings
@using OpenBudgeteer.Core.Common.Extensions
@using OpenBudgeteer.Core.ViewModels.EntityViewModels
@using Color = MudBlazor.Color
@using Size = MudBlazor.Size
@inject IMudThemeService MudThemeService
@inject IAppSettingService AppSettingService

<MudDialog Class="dialog-background">
    <TitleContent>
        <MudText Typo="Typo.h6">@Title</MudText>
    </TitleContent>
    <DialogContent>

        <!-- Bucket Details Tabs -->
        <MudTabs Outlined="true">

            <!-- Movements Tab -->
            <MudTabPanel Text="Movements">
                <MudCheckBox T="bool"
                             ValueChanged="IncludeBucketMovementCheckboxChanged"
                             Label="Show Bucket Movements"
                             Value="IncludeBucketMovements"/>
                <MudDataGrid T="TransactionViewModel"
                             Items="@DataContext.BucketMovementsData.Transactions"
                             Dense="true"
                             Elevation="0"
                             Filterable="true"
                             FilterMode="DataGridFilterMode.ColumnFilterMenu"
                             FixedHeader="true"
                             Hover="true"
                             ReadOnly="true"
                             RowsPerPage="@AppSettingService.CurrentSettings.TransactionPagerSize">
                    <Columns>

                        <!-- Date -->
                        <PropertyColumn Property="x => x.TransactionDate"
                                        Title="Date">
                            <FilterTemplate>
                                <MudGrid Spacing="6"
                                         Style="width:430px">
                                    <MudItem xs="12">
                                        <MudDateRangePicker @bind-DateRange="@_dateOnlyMudFilter.DateRange"
                                                            Margin="Margin.Dense"
                                                            PickerVariant="PickerVariant.Inline"/>
                                    </MudItem>
                                    <MudItem Class="d-flex justify-end"
                                             xs="12">
                                        <MudButton OnClick="@(() => _dateOnlyMudFilter.ResetFilterOnContextAsync(context))">
                                            Clear
                                        </MudButton>
                                        <MudButton OnClick="@(() => _dateOnlyMudFilter.ApplyFilterOnContextAsync(context))"
                                                   Color="@Color.Primary">
                                            Filter
                                        </MudButton>
                                    </MudItem>
                                </MudGrid>
                            </FilterTemplate>
                        </PropertyColumn>

                        <!-- Account -->
                        <PropertyColumn Property="x => x.SelectedAccount"
                                        Title="Account"
                                        CellStyle="min-width: 150px"
                                        Comparer="@(new MudComparer())">
                            <FilterTemplate>
                                <MudGrid Spacing="6"
                                         Style="width:430px">
                                    <MudItem xs="12">
                                        <MudSelect T="AccountViewModel"
                                                   @bind-SelectedValues="_accountMudFilter.SelectedItems"
                                                   MultiSelection="true"
                                                   MultiSelectionTextFunc="@(items => MultiSelectionTextHelper.GetText(items, "Accounts"))"
                                                   SelectAll="true">
                                            @foreach (var account in _accountMudFilter.AvailableItems)
                                            {
                                                <MudSelectItem Value="account">@account</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </MudItem>
                                    <MudItem Class="d-flex justify-end"
                                             xs="12">
                                        <MudButton OnClick="@(() => _accountMudFilter.ResetFilterOnContextAsync(context))">
                                            Clear
                                        </MudButton>
                                        <MudButton OnClick="@(() => _accountMudFilter.ApplyFilterOnContextAsync(context))"
                                                   Color="@Color.Primary">
                                            Filter
                                        </MudButton>
                                    </MudItem>
                                </MudGrid>
                            </FilterTemplate>
                        </PropertyColumn>

                        <!-- Payee -->
                        <PropertyColumn Property="x => x.Payee"/>

                        <!-- Memo -->
                        <PropertyColumn Property="x => x.Memo"/>

                        <!-- Amount -->
                        <PropertyColumn Property="x => x.Amount"
                                        Culture="CultureInfo.CurrentCulture"
                                        Format="C">
                            <CellTemplate>
                                @if (context.Item.Buckets.Count <= 1)
                                {
                                    <MudText Class="col-numbers">@context.Item.Amount.ToString("C", CultureInfo.CurrentCulture)</MudText>
                                }
                                else
                                {
                                    <MudText Class="col-numbers">@context.Item.Buckets.Where(b => b.SelectedBucketId == DataContext.BucketId).Sum(b => b.Amount).ToString("C", CultureInfo.CurrentCulture)*</MudText>
                                }
                            </CellTemplate>
                        </PropertyColumn>

                    </Columns>
                    <PagerContent>
                        <MudDataGridPager T="TransactionViewModel"/>
                    </PagerContent>
                </MudDataGrid>
            </MudTabPanel>

            <!-- Statistics Tab -->
            <MudTabPanel Text="Statistics">
                <MudGrid>

                    <!-- Month Balances -->
                    <MudItem Class="p-1 mt-2"
                             md="6"
                             sm="12">
                        <MudPaper Outlined="true">
                            <MudText Class="report-chart-header"
                                     Typo="Typo.h5">
                                Month Balances
                            </MudText>
                            <ApexChartWrapper TItem="ApexRecord"
                                              @ref="AddChartRef"
                                              ChartType="SeriesType.Bar"
                                              Options="@(new ApexChartOptions<ApexRecord> { Theme = BaseTheme })">
                                <ApexPointSeries TItem="ApexRecord"
                                                 Items="DataContext.MonthBalances"
                                                 DataPointMutator="ApexHelper.BalanceChartMutator"
                                                 Name="Balance"
                                                 SeriesType="SeriesType.Bar"
                                                 XValue="i => i.Label"
                                                 YValue="i => i.Value"/>
                            </ApexChartWrapper>
                        </MudPaper>
                    </MudItem>

                    <!-- Input & Output -->
                    <MudItem Class="p-1 mt-2"
                             md="6"
                             sm="12">
                        <MudPaper Outlined="true">
                            <MudText Class="report-chart-header"
                                     Typo="Typo.h5">
                                Input & Output
                            </MudText>
                            <ApexChartWrapper TItem="ApexRecord"
                                              @ref="AddChartRef"
                                              ChartType="SeriesType.Bar"
                                              Options="MonthInputOutputChartOptions">
                                <ApexPointSeries TItem="ApexRecord"
                                                 Items="DataContext.MonthInput"
                                                 Color="@System.Drawing.Color.Green.ToHexString()"
                                                 Name="Input"
                                                 SeriesType="SeriesType.Bar"
                                                 XValue="i => i.Label"
                                                 YValue="i => i.Value"/>
                                <ApexPointSeries TItem="ApexRecord"
                                                 Items="DataContext.MonthOutput"
                                                 Color="@System.Drawing.Color.DarkRed.ToHexString()"
                                                 Name="Output"
                                                 SeriesType="SeriesType.Bar"
                                                 XValue="i => i.Label"
                                                 YValue="i => i.Value"/>
                            </ApexChartWrapper>
                        </MudPaper>
                    </MudItem>

                    <!-- Balance Progression -->
                    <MudItem Class="p-1"
                             sm="12">
                        <MudPaper Outlined="true">
                            <MudText Class="report-chart-header"
                                     Typo="Typo.h5">
                                Balance Progression
                            </MudText>
                            <ApexChartWrapper TItem="ApexRecord"
                                              @ref="AddChartRef"
                                              ChartType="SeriesType.Area"
                                              Height="300"
                                              Options="@(new ApexChartOptions<ApexRecord> { Theme = BaseTheme })">
                                <ApexPointSeries TItem="ApexRecord"
                                                 Items="DataContext.BucketProgression"
                                                 Color="@System.Drawing.Color.Green.ToHexString()"
                                                 Name="Balance"
                                                 SeriesType="SeriesType.Area"
                                                 XValue="i => i.Label"
                                                 YValue="i => i.Value"/>
                            </ApexChartWrapper>
                        </MudPaper>
                    </MudItem>

                </MudGrid>
            </MudTabPanel>
        </MudTabs>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseDialog"
                   Color="Color.Error"
                   Size="Size.Small"
                   Variant="Variant.Filled">
            Close
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public BlazorBucketStatisticsViewModel DataContext { get; set; } = null!;

    [Parameter]
    public bool IsDialogVisible { get; set; }

    [Parameter]
    public bool IsDialogLoading { get; set; }

    [Parameter]
    public bool IncludeBucketMovements { get; set; }

    [Parameter]
    public EventCallback<MouseEventArgs> OnClickCallback { get; set; }

    private DateOnlyMudFilter<TransactionViewModel> _dateOnlyMudFilter = null!;
    private EntityViewModelMudFilter<AccountViewModel, TransactionViewModel> _accountMudFilter = null!;
    private EntityViewModelMudFilter<PartialBucketViewModel, TransactionViewModel> _bucketMudFilter = null!;

    private readonly List<ApexChartWrapper<ApexRecord>> _charts = new();
    private ApexChartWrapper<ApexRecord> AddChartRef
    {
        set => _charts.Add(value);
    }

    private Theme BaseTheme => new()
    {
        Mode = MudThemeService.CurrentThemeSetting.IsDarkMode ? Mode.Dark : Mode.Light,
        Palette = PaletteType.Palette1
    };

    private ApexChartOptions<ApexRecord> MonthInputOutputChartOptions => new()
    {
        Theme = BaseTheme,
        Legend = new() { Show = false }
    };

    private void CloseDialog() => MudDialog.Close(DialogResult.Ok(true));

    protected override void OnInitialized()
    {
        _accountMudFilter = new(new()
        {
            FilterFunction = x => _accountMudFilter.FilterItems.Contains(x.SelectedAccount)
        });
        _dateOnlyMudFilter = new(new()
        {
            FilterFunction = x =>
                x.TransactionDate.IsBetween(_dateOnlyMudFilter.DateRange.Start, _dateOnlyMudFilter.DateRange.End)
        });
        _bucketMudFilter = new(new()
        {
            FilterFunction = x => x.Buckets.Any(bucket => _bucketMudFilter.FilterItems.Contains(bucket))
        });

        ResetFilter();
    }

    private void ResetFilter()
    {
        _accountMudFilter.AvailableItems = DataContext.BucketMovementsData.Transactions
            .Select(i => i.SelectedAccount)
            .Distinct()
            .OrderBy(i => i.Name)
            .ToList();
        _bucketMudFilter.AvailableItems = DataContext.BucketMovementsData.Transactions
            .SelectMany(i => i.Buckets)
            .DistinctBy(i => i.SelectedBucketId)
            .OrderBy(i => i.SelectedBucketName)
            .ToList();

        _accountMudFilter.ResetFilter();
        _dateOnlyMudFilter.ResetFilter();
        _bucketMudFilter.ResetFilter();
    }

    private async Task IncludeBucketMovementCheckboxChanged(bool obj)
    {
        IncludeBucketMovements = obj;
        await DataContext.LoadBucketMovementsDataAsync(IncludeBucketMovements);
        ResetFilter();
        StateHasChanged();

        var tasks = new List<Task>();
        tasks.AddRange(_charts.Select(wrapper => wrapper.RefreshAsync()));
        await Task.WhenAll(tasks);
    }
}
