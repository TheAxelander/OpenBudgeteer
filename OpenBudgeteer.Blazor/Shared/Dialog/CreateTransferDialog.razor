@using OpenBudgeteer.Blazor.Common
@using OpenBudgeteer.Core.ViewModels.EntityViewModels

<MudDialog Class="dialog-background">
    <TitleContent>
        <MudText Typo="Typo.h6">Create Transfer Transactions</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="8">

            <!-- Sending -->
            <MudGrid Spacing="2">
                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle1">Sending</MudText>
                </MudItem>

                <!-- Date -->
                <MudItem xs="4">
                    <MudDatePicker DateChanged="@(time => TransactionDateChanged(SenderDataContext, time))"
                                   Date="@(SenderDataContext.TransactionDate.ToDateTime(TimeOnly.MinValue))"
                                   ShowToolbar="false"/>
                </MudItem>

                <!-- Account -->
                <MudItem xs="8">
                    <MudSelect T="AccountViewModel"
                               @bind-Value="SenderDataContext.SelectedAccount">
                        @foreach (var account in SenderDataContext.AvailableAccounts)
                        {
                            <MudSelectItem Value="@account">@account.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <!-- Payee -->
                <MudItem xs="12">
                    <MudTextField @bind-Value="SenderDataContext.Payee"
                                  Label="Payee"/>
                </MudItem>

                <!-- Memo -->
                <MudItem xs="12">
                    <MudTextField @bind-Value="SenderDataContext.Memo"
                                  Label="Memo"/>
                </MudItem>

            </MudGrid>

            <!-- Receiving -->
            <MudGrid Spacing="2">
                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle1">Receiving</MudText>
                </MudItem>

                <!-- Date -->
                <MudItem xs="4">
                    <MudDatePicker DateChanged="@(time => TransactionDateChanged(ReceiverDataContext, time))"
                                   Date="@(ReceiverDataContext.TransactionDate.ToDateTime(TimeOnly.MinValue))"
                                   ShowToolbar="false"/>
                </MudItem>

                <!-- Account -->
                <MudItem xs="8">
                    <MudSelect T="AccountViewModel"
                               @bind-Value="ReceiverDataContext.SelectedAccount">
                        @foreach (var account in ReceiverDataContext.AvailableAccounts)
                        {
                            <MudSelectItem Value="@account">@account.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <!-- Payee -->
                <MudItem xs="12">
                    <MudTextField @bind-Value="ReceiverDataContext.Payee"
                                  Label="Payee"/>
                </MudItem>

                <!-- Memo -->
                <MudItem xs="12">
                    <MudTextField @bind-Value="ReceiverDataContext.Memo"
                                  Label="Memo"/>
                </MudItem>

            </MudGrid>

            <!-- Exchanging amount -->
            <MudGrid Spacing="2">
                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle1">Exchanging amount</MudText>
                </MudItem>
                <MudItem xs="12">
                    <MudNumericField T="decimal"
                                     @bind-Value="Amount"
                                     Format="N2"
                                     Label="Amount"/>
                </MudItem>
            </MudGrid>

        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="ConfirmCreate"
                   Color="Color.Primary"
                   Size="Size.Small"
                   Variant="Variant.Filled">
            Create
        </MudButton>
        <MudButton OnClick="ConfirmCreateAnother"
                   Color="Color.Primary"
                   Size="Size.Small"
                   Variant="Variant.Filled">
            Create another
        </MudButton>
        <MudButton OnClick="CancelDialog"
                   Color="Color.Error"
                   Size="Size.Small"
                   Variant="Variant.Filled">
            Cancel
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public TransactionViewModel SenderDataContext { get; set; } = null!;

    [Parameter]
    public TransactionViewModel ReceiverDataContext { get; set; } = null!;

    private decimal _amount;
    public decimal Amount
    {
        get => _amount;
        set
        {
            if (value == _amount) return;
            _amount = value;
            SenderDataContext.Amount = _amount * -1;
            ReceiverDataContext.Amount = _amount;
        }
    }

    void ConfirmCreate() => MudDialog.Close(DialogResult.Ok(CreateDialogResponse.Create));
    void ConfirmCreateAnother() => MudDialog.Close(DialogResult.Ok(CreateDialogResponse.CreateAnother));
    void CancelDialog() => MudDialog.Cancel();

    void TransactionDateChanged(TransactionViewModel transaction, DateTime? dateTime)
    {
        transaction.TransactionDate = DateOnly.FromDateTime(dateTime ?? DateTime.Today);
    }
}
