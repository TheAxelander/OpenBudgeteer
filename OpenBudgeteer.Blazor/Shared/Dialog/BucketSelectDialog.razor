@using System.Drawing
@using System.Globalization
@using System.Threading
@using OpenBudgeteer.Core.ViewModels.EntityViewModels
@using OpenBudgeteer.Core.ViewModels.Helper
@using Color = MudBlazor.Color
@using Size = MudBlazor.Size

<MudDialog Class="dialog-background">
    <TitleContent>
        <MudText Typo="Typo.h6">Select Bucket</MudText>
    </TitleContent>
    <DialogContent>

        <!-- Quick selection -->
        <MudFocusTrap DefaultFocus="DefaultFocus.FirstChild">
            <MudAutocomplete T="BucketViewModel"
                             SearchFunc="BucketQuickSelectSearchFunction"
                             ValueChanged="BucketQuickSelectChanged"
                             Class="mb-4"
                             Dense="true"
                             Label="Bucket quick select"
                             Margin="Margin.Dense"
                             Variant="Variant.Outlined"/>
        </MudFocusTrap>

        <!-- Bucket listing -->
        <MudTable Items="@DataContext.LoadedBuckets"
                  Dense="true"
                  FixedHeader="true"
                  GroupBy="@_groupByBucketGroup"
                  GroupHeaderStyle="background-color:var(--mud-palette-background-gray)"
                  Hover="true">
            <HeaderContent>
                <MudTh>Bucket</MudTh>
                <MudTh Class="col-numbers col-bucket-numbers">Balance</MudTh>
                <MudTh Class="col-numbers col-bucket-numbers">In</MudTh>
                <MudTh Class="col-numbers col-bucket-numbers">Activity</MudTh>
                <MudTh>Details</MudTh>
                <MudTh/>
            </HeaderContent>
            <GroupHeaderTemplate>
                <MudTh>@((context.Key as BucketGroupViewModel)!.Name)</MudTh>
                <MudTh Class="col-numbers col-bucket-numbers">@((context.Key as BucketGroupViewModel)!.TotalBalance.ToString("C", CultureInfo.CurrentCulture))</MudTh>
                <MudTh Class="col-numbers col-bucket-numbers">@((context.Key as BucketGroupViewModel)!.TotalIn == 0 ? string.Empty : (context.Key as BucketGroupViewModel)!.TotalIn.ToString("C", CultureInfo.CurrentCulture))</MudTh>
                <MudTh Class="col-numbers col-bucket-numbers">@((context.Key as BucketGroupViewModel)!.TotalActivity == 0 ? string.Empty : (context.Key as BucketGroupViewModel)!.TotalActivity.ToString("C", CultureInfo.CurrentCulture))</MudTh>
                <MudTh/>
                <MudTh/>
            </GroupHeaderTemplate>
            <RowTemplate>

                <!-- Bucket -->
                <MudTd DataLabel="Bucket">
                    <MudButton OnClick="@(() => ConfirmSelection(context))"
                               Class="mud-width-full bucket-indicator"
                               Size="Size.Small"
                               Style="@($"background-color: {ColorTranslator.ToHtml(context.Color)}; color: {ColorTranslator.ToHtml(context.TextColor)}")">
                        @context.Name
                    </MudButton>
                </MudTd>

                <!-- Balance -->
                <MudTd Class="col-numbers"
                       DataLabel="Balance">
                    @context.Balance.ToString("C", CultureInfo.CurrentCulture)
                </MudTd>

                <!-- In -->
                <MudTd Class="col-numbers"
                       DataLabel="In">
                    @(context.In == 0 ? string.Empty : context.In.ToString("C", CultureInfo.CurrentCulture))
                </MudTd>

                <!-- Activity -->
                <MudTd Class="col-numbers"
                       DataLabel="Activity">
                    @(context.Activity == 0 ? string.Empty : context.Activity.ToString("C", CultureInfo.CurrentCulture))
                </MudTd>

                <!-- Details -->
                <MudTd colspan="2"
                       DataLabel="Details">
                    <MudStack Row
                              StretchItems="StretchItems.Start">
                        @if (context.IsProgressbarVisible)
                        {
                            <MudStack Spacing="1">
                                <MudProgressLinear Color="Color.Info"
                                                   Rounded
                                                   Size="Size.Large"
                                                   Value="context.Progress">
                                    <MudText Color="Color.Dark"
                                             Typo="Typo.caption">
                                        <b>@context.Progress%</b>
                                    </MudText>
                                </MudProgressLinear>
                                <MudText Align="Align.Center"
                                         Typo="Typo.caption">
                                    @context.Details
                                </MudText>
                            </MudStack>
                        }
                    </MudStack>
                </MudTd>

            </RowTemplate>
        </MudTable>

    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CancelSelection"
                   Color="Color.Error"
                   Size="Size.Small"
                   Variant="Variant.Filled">
            Cancel
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public BucketListingViewModel DataContext { get; set; } = null!;

    [Parameter]
    public bool IsDialogVisible { get; set; }

    [Parameter]
    public bool IsDialogLoading { get; set; }

    [Parameter]
    public EventCallback<BucketViewModel> OnBucketSelectedCallback { get; set; }

    [Parameter]
    public EventCallback<MouseEventArgs> OnCancelCallback { get; set; }

    private readonly TableGroupDefinition<BucketViewModel> _groupByBucketGroup = new()
    {
        GroupName = "Bucket Group:",
        Expandable = true,
        Selector = x => x.BucketGroupViewModel!
    };

    private void CancelSelection() => MudDialog.Close();

    private void ConfirmSelection(BucketViewModel bucket) => MudDialog.Close(DialogResult.Ok(bucket));

    private void BucketQuickSelectChanged(BucketViewModel bucket) => ConfirmSelection(bucket);

    private async Task<IEnumerable<BucketViewModel>> BucketQuickSelectSearchFunction(string? searchString, CancellationToken cancellationToken)
    {
        return await Task.Run(() =>
        {
            var buckets = DataContext.BucketGroups
                .SelectMany(i => i.Buckets)
                .Order()
                .ToList();

            return string.IsNullOrEmpty(searchString) ?
                buckets :
                buckets.Where(i => i.Name.Contains(searchString, StringComparison.InvariantCultureIgnoreCase));
        }, cancellationToken);
    }

}
