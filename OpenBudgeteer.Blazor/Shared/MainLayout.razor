@inherits LayoutComponentBase
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Configuration
@using OpenBudgeteer.Core.Data
@using OpenBudgeteer.Core.Data.Entities
@inject IDbContextFactory<DatabaseContext> DbContextFactory
@inject MudThemeService MudThemeService
@inject IConfiguration Configuration

<MudThemeProvider IsDarkMode="@MudThemeService.CurrentThemeSetting.IsDarkMode"
                  Theme="MudThemeService.CurrentThemeSetting.CurrentTheme"/>
<MudPopoverProvider/>
<MudDialogProvider BackdropClick="false"
                   CloseOnEscapeKey="false"/>
<MudSnackbarProvider/>

<MudLayout>

    <!-- Top Bar -->
    <MudAppBar>

        <!-- Left side-->
        <MudIconButton OnClick="DrawerToggle"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       Icon="@Icons.Material.Filled.Menu"/>
        <MudImage Class="ms-1 me-3 pa-1 rounded-circle"
                  Height="40"
                  Src="favicon.ico"
                  Style=@($"background-color: {AppIconBackground};")/>
        <MudText>OpenBudgeteer</MudText>

        <!-- Blazor reconnect dialog  -->
        <MudSpacer/>
        <div id="components-reconnect-modal">
            <MudAlert Dense="true"
                      NoIcon="true"
                      Severity="Severity.Warning"
                      Variant="Variant.Outlined">
                <MudStack Row
                          Spacing="4">
                    <MudIcon Color="Color.Warning"
                             Icon="@Icons.Material.Filled.WarningAmber"/>
                    <MudText>
                        Connection lost. Current reconnect attempt:
                        <span id="components-reconnect-current-attempt"></span> /
                        <span id="components-reconnect-max-retries"></span>
                    </MudText>
                    <MudProgressCircular Color="Color.Primary"
                                         Indeterminate="true"
                                         Size="Size.Small"/>
                </MudStack>
            </MudAlert>
        </div>
        <MudSpacer/>

        <!-- Right side  -->
        <MudIconButton Color="Color.Inherit"
                       Href="https://github.com/TheAxelander/OpenBudgeteer"
                       Icon="@Icons.Custom.Brands.GitHub"
                       Target="_blank"/>
        <MudIconButton Color="Color.Inherit"
                       Href="https://theaxelander.github.io/"
                       Icon="@Icons.Material.Filled.MenuBook"
                       Target="_blank"/>
        @if (Configuration.GetValue(ConfigurationKeyConstants.APPSETTINGS_AUTH_ENABLED, false))
        {
            <AuthorizeView>
                <Authorized>
                    <MudTooltip Text="Logout">
                        <form action="/auth/logout"
                              method="post"
                              style="display: inline;">
                            <MudIconButton ButtonType="ButtonType.Submit"
                                           Color="Color.Inherit"
                                           Icon="@Icons.Material.Filled.Logout"/>
                        </form>
                    </MudTooltip>
                    <MudIcon Class="ms-2"
                             Color="Color.Inherit"
                             Icon="@Icons.Material.Filled.HorizontalRule"
                             Style="rotate: 90deg"/>
                    <MudText Class="ms-2">@context.User.Identity?.Name</MudText>
                </Authorized>
            </AuthorizeView>
        }
        <MudIcon Class="ms-2"
                 Color="Color.Inherit"
                 Icon="@Icons.Material.Filled.HorizontalRule"
                 Style="rotate: 90deg"/>
        <MudText Class="ms-2">@CurrentDatabase</MudText>
        <MudIcon Class="ms-2"
                 Color="Color.Inherit"
                 Icon="@Icons.Material.Filled.HorizontalRule"
                 Style="rotate: 90deg"/>
        <MudText Class="ms-2 d-none d-md-block">
            Version: 1.11.0 (<MudLink Color="Color.Inherit" Href="https://github.com/TheAxelander/OpenBudgeteer/blob/master/CHANGELOG.md" Target="_blank">Change Log</MudLink>)
        </MudText>
    </MudAppBar>

    <!-- Navigation Menu -->
    <MudDrawer @bind-Open="@_drawerOpen"
               ClipMode="DrawerClipMode.Docked">
        <NavMenu/>
    </MudDrawer>

    <!-- Main content -->
    <MudMainContent>
        <ErrorBoundary @ref="_errorBoundary">

            <!-- Main content -->
            <ChildContent>
                <MudContainer Class="pt-6 pb-6"
                              MaxWidth="MaxWidth.False">
                    @Body
                </MudContainer>
            </ChildContent>

            <!-- Error content -->
            <ErrorContent Context="exception">
                <MudContainer Class="pt-6 pb-6"
                              MaxWidth="MaxWidth.False">
                    <MudStack Spacing="4">
                        <MudAlert OnClick="() => _errorMessageExpanded = !_errorMessageExpanded"
                                  Severity="Severity.Error"
                                  Variant="Variant.Outlined">
                            An unexpected error occured. Feel free to create an issue on GitHub and include below
                            report.
                        </MudAlert>
                        <MudDivider/>
                        <MudExpansionPanels>
                            <MudExpansionPanel Text="Detailed Report">
                                <MudStack Spacing="4">
                                    <MudText Typo="Typo.h5">Error Message</MudText>
                                    <MudText>@exception.Message</MudText>
                                    <MudText Typo="Typo.h5">Stack Trace</MudText>
                                    <MudTextField T="string"
                                                  AutoGrow
                                                  ReadOnly="true"
                                                  Text="@exception.StackTrace"
                                                  Variant="Variant.Outlined"/>
                                </MudStack>
                            </MudExpansionPanel>
                        </MudExpansionPanels>
                    </MudStack>
                </MudContainer>
            </ErrorContent>
        </ErrorBoundary>
    </MudMainContent>
</MudLayout>

@code {
    private string AppIconBackground => MudThemeService.CurrentThemeSetting.IsDarkMode ? "#616161" : "white";
    private string CurrentDatabase => DbContextFactory.CreateDbContext().Database.GetDbConnection().Database;
    private bool _drawerOpen = true;

    private ErrorBoundary? _errorBoundary;
    bool _errorMessageExpanded;

    protected override void OnInitialized()
    {
        MudThemeService.ThemeChanged += async (_, _) => await InvokeAsync(StateHasChanged);
    }

    protected override void OnParametersSet()
    {
        _errorBoundary?.Recover();
    }

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }
}
