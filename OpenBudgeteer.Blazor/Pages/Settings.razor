@page "/settings"
@attribute [Authorize]

<!-- Setting Tabs -->
<MudTabs Elevation="2"
         PanelClass="pa-4"
         Rounded>

    <!-- Theme Tab -->
    <MudTabPanel Icon="@Icons.Material.Filled.ColorLens"
                 Text="Theme">

        <!-- Theme Action Buttons -->
        <MudStack AlignItems="AlignItems.Center"
                  Row
                  Spacing="2"
                  Wrap="Wrap.Wrap">
            <MudButton OnClick="ApplyThemeAsync"
                       Color="Color.Primary"
                       Size="Size.Small"
                       Variant="Variant.Filled">
                Apply Changes
            </MudButton>
            <MudButton OnClick="RestoreThemeAsync"
                       Color="Color.Primary"
                       Size="Size.Small"
                       Variant="Variant.Filled">
                Restore Theme
            </MudButton>
            <MudButton OnClick="RestoreDefaultThemeAsync"
                       Color="Color.Primary"
                       Size="Size.Small"
                       Variant="Variant.Filled">
                Restore Default
            </MudButton>
            <MudSwitch @bind-Value="_dataContext.UseDarkTheme"
                       Color="Color.Primary"
                       Label="Use Dark Theme"/>
            <MudSwitch @bind-Value="_showAll"
                       Color="Color.Primary"
                       Label="Show all"/>
        </MudStack>

        <!-- Theme Settings -->
        <MudGrid>

            <!-- Theme Colors -->
            <MudItem md="4"
                     sm="12">
                <MudText Class="pt-4 mx-4"
                         GutterBottom="true"
                         Typo="Typo.body2">
                    <b>Theme Colors</b>
                </MudText>
                <MudThemeColorItem @bind-Value="@_dataContext.CurrentPalette.Primary"
                                   ColorPickerView="ColorPickerView.Spectrum"
                                   Name="Primary"/>
                @if (_showAll)
                {
                    <MudThemeColorItem @bind-Value="@_dataContext.CurrentPalette.Secondary"
                                       ColorPickerView="ColorPickerView.Spectrum"
                                       Name="Secondary"/>
                    <MudThemeColorItem @bind-Value="@_dataContext.CurrentPalette.Tertiary"
                                       ColorPickerView="ColorPickerView.Spectrum"
                                       Name="Tertiary"/>
                }
                <MudThemeColorItem @bind-Value="@_dataContext.CurrentPalette.Info"
                                   ColorPickerView="ColorPickerView.Spectrum"
                                   Name="Info"/>
                <MudThemeColorItem @bind-Value="@_dataContext.CurrentPalette.Success"
                                   ColorPickerView="ColorPickerView.Spectrum"
                                   Name="Success"/>
                <MudThemeColorItem @bind-Value="@_dataContext.CurrentPalette.Warning"
                                   ColorPickerView="ColorPickerView.Spectrum"
                                   Name="Warning"/>
                <MudThemeColorItem @bind-Value="@_dataContext.CurrentPalette.Error"
                                   ColorPickerView="ColorPickerView.Spectrum"
                                   Name="Error"/>
                @if (_showAll)
                {
                    <MudThemeColorItem @bind-Value="@_dataContext.CurrentPalette.Dark"
                                       ColorPickerView="ColorPickerView.Spectrum"
                                       Name="Dark"/>
                }
            </MudItem>

            <!-- Components (default hidden) -->
            @if (_showAll)
            {
                <MudItem md="4"
                         sm="12">
                    <MudText Class="pt-4 mx-4"
                             GutterBottom="true"
                             Typo="Typo.body2">
                        <b>Components</b>
                    </MudText>
                    <MudThemeColorItem @bind-Value="@_dataContext.CurrentPalette.AppbarText"
                                       ColorPickerView="ColorPickerView.Spectrum"
                                       Name="Appbar Text"/>
                    <MudThemeColorItem @bind-Value="@_dataContext.CurrentPalette.AppbarBackground"
                                       ColorPickerView="ColorPickerView.Spectrum"
                                       Name="Appbar Background"/>
                    <MudThemeColorItem @bind-Value="@_dataContext.CurrentPalette.DrawerText"
                                       ColorPickerView="ColorPickerView.Spectrum"
                                       Name="Drawer Text"/>
                    <MudThemeColorItem @bind-Value="@_dataContext.CurrentPalette.DrawerIcon"
                                       ColorPickerView="ColorPickerView.Spectrum"
                                       Name="Drawer Icons"/>
                    <MudThemeColorItem @bind-Value="@_dataContext.CurrentPalette.DrawerBackground"
                                       ColorPickerView="ColorPickerView.Spectrum"
                                       Name="Drawer Background"/>
                </MudItem>
            }

            <!-- General -->
            <MudItem md="4"
                     sm="12">
                <MudText Class="pt-4 mx-4"
                         GutterBottom="true"
                         Typo="Typo.body2">
                    <b>General</b>
                </MudText>
                <MudThemeColorItem @bind-Value="@_dataContext.CurrentPalette.Surface"
                                   ColorPickerView="ColorPickerView.Spectrum"
                                   Name="Surface"/>
                <MudThemeColorItem @bind-Value="@_dataContext.CurrentPalette.Background"
                                   ColorPickerView="ColorPickerView.Spectrum"
                                   Name="Background"/>
                @if (_showAll)
                {
                    <MudThemeColorItem @bind-Value="@_dataContext.CurrentPalette.BackgroundGray"
                                       ColorPickerView="ColorPickerView.Spectrum"
                                       Name="Background Gray"/>
                    <MudThemeColorItem @bind-Value="@_dataContext.CurrentPalette.LinesDefault"
                                       ColorPickerView="ColorPickerView.Spectrum"
                                       Name="Lines Default"/>
                    <MudThemeColorItem @bind-Value="@_dataContext.CurrentPalette.LinesInputs"
                                       ColorPickerView="ColorPickerView.Spectrum"
                                       Name="Lines Inputs"/>
                    <MudThemeColorItem @bind-Value="@_dataContext.CurrentPalette.Divider"
                                       ColorPickerView="ColorPickerView.Spectrum"
                                       Name="Divider"/>
                    <MudThemeColorItem @bind-Value="@_dataContext.CurrentPalette.DividerLight"
                                       ColorPickerView="ColorPickerView.Spectrum"
                                       Name="Divider Light"/>
                }
            </MudItem>

            <!-- Text & Actions -->
            <MudItem md="4"
                     sm="12">
                <MudText Class="pt-4 mx-4"
                         GutterBottom="true"
                         Typo="Typo.body2">
                    <b>Text & Actions</b>
                </MudText>
                <MudThemeColorItem @bind-Value="@_dataContext.CurrentPalette.TextPrimary"
                                   ColorPickerView="ColorPickerView.Spectrum"
                                   Name="Text Primary"/>
                <MudThemeColorItem @bind-Value="@_dataContext.CurrentPalette.TextSecondary"
                                   ColorPickerView="ColorPickerView.Spectrum"
                                   Name="Text Secondary"/>
                @if (_showAll)
                {
                    <MudThemeColorItem @bind-Value="@_dataContext.CurrentPalette.TextDisabled"
                                       ColorPickerView="ColorPickerView.Spectrum"
                                       Name="Text Disabled"/>
                    <MudThemeColorItem @bind-Value="@_dataContext.CurrentPalette.ActionDefault"
                                       ColorPickerView="ColorPickerView.Spectrum"
                                       Name="Action Default"/>
                    <MudThemeColorItem @bind-Value="@_dataContext.CurrentPalette.ActionDisabled"
                                       ColorPickerView="ColorPickerView.Spectrum"
                                       Name="Action Disabled"/>
                    <MudThemeColorItem @bind-Value="@_dataContext.CurrentPalette.ActionDisabledBackground"
                                       ColorPickerView="ColorPickerView.Spectrum"
                                       Name="Disabled Background"/>
                }
                <MudThemeColorItem @bind-Value="@_dataContext.CurrentPalette.Surface"
                                   ColorPickerView="ColorPickerView.Spectrum"
                                   Name="Surface"/>
            </MudItem>
        </MudGrid>
    </MudTabPanel>

    <!-- Misc Tab -->
    <MudTabPanel Icon="@Icons.Material.Filled.Settings"
                 Text="Misc">

        <!-- Misc Action Buttons -->
        <MudStack AlignItems="AlignItems.Center"
                  Row
                  Spacing="3"
                  Wrap="Wrap.Wrap">
            <MudButton OnClick="ApplySettingsAsync"
                       Color="Color.Primary"
                       Size="Size.Small"
                       Variant="Variant.Filled">
                Apply Changes
            </MudButton>
            <MudButton OnClick="RestoreSettingsAsync"
                       Color="Color.Error"
                       Size="Size.Small"
                       Variant="Variant.Filled">
                Cancel
            </MudButton>
        </MudStack>

        <!-- Misc Settings -->
        <MudGrid Class="pt-4"
                 Spacing="6">

            <!-- Home Page & Transaction Listing (left side) -->
            <MudItem sm="6"
                     xs="12">
                <MudStack>
                    <MudText Typo="Typo.h5">Home Page</MudText>
                    <MudGrid>
                        <MudItem Class="d-flex align-center"
                                 xs="9">
                            <MudText Typo="Typo.body2">Displayed amount of Top X Transactions</MudText>
                        </MudItem>
                        <MudItem Class="d-flex align-center"
                                 xs="3">
                            <MudNumericField T="int"
                                             @bind-Value="_dataContext.HomePageTopCount"/>
                        </MudItem>
                    </MudGrid>
                    <MudText Typo="Typo.h5">Transaction Listing</MudText>
                    <MudGrid>
                        <MudItem Class="d-flex align-center"
                                 xs="9">
                            <MudText Typo="Typo.body2">Default row per page</MudText>
                        </MudItem>
                        <MudItem Class="d-flex align-center"
                                 xs="3">
                            <MudSelect @bind-Value="_dataContext.TransactionPageSize"
                                       Dense>
                                <MudSelectItem Value="10">10</MudSelectItem>
                                <MudSelectItem Value="25">25</MudSelectItem>
                                <MudSelectItem Value="50">50</MudSelectItem>
                                <MudSelectItem Value="100">100</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                    </MudGrid>
                </MudStack>
            </MudItem>

            <!-- Report Page (right side) -->
            <MudItem sm="6"
                     xs="12">
                <MudStack>
                    <MudText Typo="Typo.h5">Report Page</MudText>
                    <MudText Typo="Typo.body1">Set the time frame of data that should be shown</MudText>
                    <MudGrid>
                        <MudItem Class="d-flex align-center"
                                 xs="9">
                            <MudText Typo="Typo.body2">Month Balance Chart</MudText>
                        </MudItem>
                        <MudItem Class="d-flex align-center"
                                 xs="3">
                            <MudNumericField T="int"
                                             @bind-Value="_dataContext.ReportPageMonthBalanceCount"
                                             Label="Months"/>
                        </MudItem>
                    </MudGrid>
                    <MudGrid>
                        <MudItem Class="d-flex align-center"
                                 xs="9">
                            <MudText Typo="Typo.body2">Bank Balance Chart</MudText>
                        </MudItem>
                        <MudItem Class="d-flex align-center"
                                 xs="3">
                            <MudNumericField T="int"
                                             @bind-Value="_dataContext.ReportPageBankBalanceCount"
                                             Label="Months"/>
                        </MudItem>
                    </MudGrid>
                    <MudGrid>
                        <MudItem Class="d-flex align-center"
                                 xs="9">
                            <MudText Typo="Typo.body2">Month Income & Expenses Chart</MudText>
                        </MudItem>
                        <MudItem Class="d-flex align-center"
                                 xs="3">
                            <MudNumericField T="int"
                                             @bind-Value="_dataContext.ReportPageMonthIncomeExpensesCount"
                                             Label="Months"/>
                        </MudItem>
                    </MudGrid>
                    <MudGrid>
                        <MudItem Class="d-flex align-center"
                                 xs="9">
                            <MudText Typo="Typo.body2">Year Income & Expenses Chart</MudText>
                        </MudItem>
                        <MudItem Class="d-flex align-center"
                                 xs="3">
                            <MudNumericField T="int"
                                             @bind-Value="_dataContext.ReportPageYearIncomeExpensesCount"
                                             Label="Years"/>
                        </MudItem>
                    </MudGrid>
                    <MudGrid>
                        <MudItem Class="d-flex align-center"
                                 xs="9">
                            <MudText Typo="Typo.body2">Month Bucket Expenses Charts</MudText>
                        </MudItem>
                        <MudItem Class="d-flex align-center"
                                 xs="3">
                            <MudNumericField T="int"
                                             @bind-Value="_dataContext.ReportPageMonthBucketExpensesCount"
                                             Label="Months"/>
                        </MudItem>
                    </MudGrid>
                </MudStack>
            </MudItem>
        </MudGrid>
    </MudTabPanel>
</MudTabs>

