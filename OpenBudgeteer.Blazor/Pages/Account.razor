@page "/account"
@attribute [Authorize]
@using System.Globalization

<!-- Action Buttons -->
<MudStack AlignItems="AlignItems.Center"
          Class="mb-2"
          Row
          Spacing="2"
          Wrap="Wrap.Wrap">
    <MudButton OnClick="@(() => ShowEditAccountDialog(null))"
               Color="Color.Primary"
               Size="Size.Small"
               Variant="Variant.Filled">
        New account
    </MudButton>
</MudStack>

<!-- Account Cards -->
<MudElement Class="d-flex flex-wrap no-background"
            HtmlTag="div">
    @foreach (var account in _dataContext.Accounts)
    {
        <MudCard Class="card-account me-2 mb-2">
            <MudCardContent>
                <MudText Typo="Typo.h5">@account.Name</MudText>
                <MudText Typo="Typo.body2">Balance: @account.Balance.ToString("C", CultureInfo.CurrentCulture)</MudText>
            </MudCardContent>
            <MudCardActions>
                <MudButton OnClick="@(() => ShowTransactionListingDialog(account))"
                           Class="me-2"
                           Color="Color.Primary"
                           Size="Size.Small"
                           Variant="Variant.Filled">
                    Display Transactions
                </MudButton>
                <MudButton OnClick="@(() => ShowEditAccountDialog(account))"
                           Class="me-2"
                           Color="Color.Primary"
                           Size="Size.Small"
                           Variant="Variant.Filled">
                    Edit
                </MudButton>
                <MudButton OnClick="@(() => ShowCloseAccountDialog(account))"
                           Color="Color.Error"
                           Size="Size.Small"
                           Variant="Variant.Filled">
                    Close
                </MudButton>
            </MudCardActions>
        </MudCard>
    }
</MudElement>
