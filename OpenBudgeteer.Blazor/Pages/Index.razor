@page "/"
@attribute [Authorize]
@using System.Globalization
@using OpenBudgeteer.Blazor.Common
@using OpenBudgeteer.Core.ViewModels.EntityViewModels

<MudStack Spacing="4">

    <!-- Github Cards -->
    <MudStack Justify="Justify.SpaceEvenly"
              Row
              Spacing="4"
              Wrap="Wrap.Wrap">
        <MudPaper Class="pa-2"
                  Elevation="2"
                  Width="350px">
            <MudStack Row>
                <svg class="mud-icon-root mud-icon-default mud-svg-icon"
                     focusable="false"
                     viewBox="0 0 24 24"
                     aria-hidden="true"
                     role="img"
                     style="font-size: 100px;">
                    <path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2 0 1.9 1.2 1.9 1.2 1 1.8 2.8 1.3 3.5 1 0-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.3-3.1-.2-.4-.6-1.6 0-3.2 0 0 1-.3 3.4 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.6.2 2.8 0 3.2.9.8 1.3 1.9 1.3 3.2 0 4.6-2.8 5.6-5.5 5.9.5.4.9 1 .9 2.2v3.3c0 .3.1.7.8.6A12 12 0 0 0 12 .3"></path>
                </svg>
                <MudStack>
                    <MudText Typo="Typo.body1">Access source code hosted on Github.</MudText>
                    <MudLink Color="Color.Primary"
                             Href="https://github.com/TheAxelander/OpenBudgeteer"
                             Target="_blank">
                        Open Repository
                    </MudLink>
                </MudStack>
            </MudStack>
        </MudPaper>
        <MudPaper Class="pa-2"
                  Elevation="2"
                  Width="350px">
            <MudStack Row>
                <svg class="mud-icon-root mud-icon-default mud-svg-icon"
                     focusable="false"
                     viewBox="0 0 24 24"
                     aria-hidden="true"
                     role="img"
                     style="font-size: 100px;">
                    <path d="M20 8h-2.81c-.45-.78-1.07-1.45-1.82-1.96L17 4.41 15.59 3l-2.17 2.17C12.96 5.06 12.49 5 12 5c-.49 0-.96.06-1.41.17L8.41 3 7 4.41l1.62 1.63C7.88 6.55 7.26 7.22 6.81 8H4v2h2.09c-.05.33-.09.66-.09 1v1H4v2h2v1c0 .34.04.67.09 1H4v2h2.81c1.04 1.79 2.97 3 5.19 3s4.15-1.21 5.19-3H20v-2h-2.09c.05-.33.09-.66.09-1v-1h2v-2h-2v-1c0-.34-.04-.67-.09-1H20V8zm-6 8h-4v-2h4v2zm0-4h-4v-2h4v2z"></path>
                </svg>
                <MudStack>
                    <MudText Typo="Typo.body1">Found a bug or missing a feature? Create an issue.</MudText>
                    <MudLink Color="Color.Primary"
                             Href="https://github.com/TheAxelander/OpenBudgeteer/issues/new/choose"
                             Target="_blank">
                        Create Issue
                    </MudLink>
                </MudStack>
            </MudStack>
        </MudPaper>
        <MudPaper Class="pa-2"
                  Elevation="2"
                  Width="350px">
            <MudStack Row>
                <svg class="mud-icon-root mud-icon-default mud-svg-icon"
                     focusable="false"
                     viewBox="0 0 24 24"
                     aria-hidden="true"
                     role="img"
                     style="font-size: 100px;">
                    <path d="M0 0h24v24H0z"
                          fill="none"></path>
                    <path d="M20 2H4c-1.1 0-1.99.9-1.99 2L2 22l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-7 9h-2V5h2v6zm0 4h-2v-2h2v2z"></path>
                </svg>
                <MudStack>
                    <MudText Typo="Typo.body1">See latest updates and announcements.</MudText>
                    <MudLink Color="Color.Primary"
                             Href="https://github.com/TheAxelander/OpenBudgeteer/discussions/categories/announcements"
                             Target="_blank">
                        Display Announcements
                    </MudLink>
                </MudStack>
            </MudStack>
        </MudPaper>
    </MudStack>

    <!-- Statistics -->
    <MudText Typo="Typo.h5">Statistics</MudText>
    <MudGrid>
        <MudItem xs="12"
                 sm="6">
            <MudStack Spacing="1">
                <MudStack AlignItems="AlignItems.Center"
                          Row
                          StretchItems="StretchItems.Start">
                    <MudText Typo="Typo.body1">Total Accounts:</MudText>
                    <MudChip T="string"
                             Color="Color.Primary"
                             Size="Size.Small">
                        @_dataContext.TotalAccounts
                    </MudChip>
                </MudStack>
                <MudStack AlignItems="AlignItems.Center"
                          Row
                          StretchItems="StretchItems.Start">
                    <MudText Typo="Typo.body1">Total Transactions:</MudText>
                    <MudChip T="string"
                             Color="Color.Primary"
                             Size="Size.Small">
                        @_dataContext.TotalTransactions
                    </MudChip>
                </MudStack>
                <MudStack AlignItems="AlignItems.Center"
                          Row
                          StretchItems="StretchItems.Start">
                    <MudText Typo="Typo.body1">Total Buckets:</MudText>
                    <MudChip T="string"
                             Color="Color.Primary"
                             Size="Size.Small">
                        @_dataContext.TotalBuckets
                    </MudChip>
                </MudStack>
            </MudStack>
        </MudItem>
        <MudItem xs="12"
                 sm="6">
            <MudStack Spacing="1">
                <MudStack AlignItems="AlignItems.Center"
                          Row
                          StretchItems="StretchItems.Start">
                    <MudText Typo="Typo.body1">Bank Balance (today):</MudText>
                    <MudChip T="string"
                             Color="Color.Primary"
                             Size="Size.Small">
                        @_dataContext.BankBalanceToday.ToString("C", CultureInfo.CurrentCulture)
                    </MudChip>
                </MudStack>
                <MudStack AlignItems="AlignItems.Center"
                          Row
                          StretchItems="StretchItems.Start">
                    <MudText Typo="Typo.body1">Bank Balance (last year):</MudText>
                    <MudChip T="string"
                             Color="Color.Primary"
                             Size="Size.Small">
                        @_dataContext.BankBalanceLastYear.ToString("C", CultureInfo.CurrentCulture)
                    </MudChip>
                </MudStack>
                <MudStack AlignItems="AlignItems.Center"
                          Row
                          StretchItems="StretchItems.Start">
                    <MudText Typo="Typo.body1">Difference:</MudText>
                    <MudChip T="string"
                             Color="@(_dataContext.BankBalanceDifference < 0 ? Color.Error : Color.Success)"
                             Size="Size.Small">
                        @_dataContext.BankBalanceDifference.ToString("C", CultureInfo.CurrentCulture)
                    </MudChip>
                </MudStack>
            </MudStack>
        </MudItem>
    </MudGrid>

    <!-- Highest Incomes -->
    <MudText Typo="Typo.h5">Highest Incomes</MudText>
    <MudDataGrid T="TransactionViewModel"
                 Items="@_dataContext.HighestIncomes"
                 Dense="true"
                 FixedHeader="true"
                 Hover="true"
                 ReadOnly="true">
        <Columns>
            <PropertyColumn Property="x => x.TransactionDate"
                            Title="Date"/>
            <PropertyColumn Property="x => x.SelectedAccount"
                            Title="Account"
                            CellStyle="min-width: 150px"
                            Comparer="@(new MudComparer())"/>
            <PropertyColumn Property="x => x.Payee"/>
            <PropertyColumn Property="x => x.Memo"/>
            <PropertyColumn Property="x => x.Amount"
                            CellClass="col-numbers"
                            Culture="CultureInfo.CurrentCulture"
                            Format="C"/>
        </Columns>
    </MudDataGrid>

    <!-- Highest Expenses -->
    <MudText Typo="Typo.h5">Highest Expenses</MudText>
    <MudDataGrid T="TransactionViewModel"
                 Items="@_dataContext.HighestExpenses"
                 Dense="true"
                 FixedHeader="true"
                 Hover="true"
                 ReadOnly="true">
        <Columns>
            <PropertyColumn Property="x => x.TransactionDate"
                            Title="Date"/>
            <PropertyColumn Property="x => x.SelectedAccount"
                            Title="Account"
                            CellStyle="min-width: 150px"/>
            <PropertyColumn Property="x => x.Payee"/>
            <PropertyColumn Property="x => x.Memo"/>
            <PropertyColumn Property="x => x.Amount"
                            CellClass="col-numbers"
                            Culture="CultureInfo.CurrentCulture"
                            Format="C"/>
        </Columns>
    </MudDataGrid>
</MudStack>

