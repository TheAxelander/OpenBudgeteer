@page "/rules"
@attribute [Authorize]
@using System.Drawing
@using OpenBudgeteer.Blazor.Common
@using OpenBudgeteer.Core.Common.Extensions
@using OpenBudgeteer.Core.ViewModels.EntityViewModels
@using Color = MudBlazor.Color
@using Size = MudBlazor.Size

<!-- Action Buttons -->
<MudStack AlignItems="AlignItems.Center"
          Class="mb-2"
          Row
          Spacing="2"
          Wrap="Wrap.Wrap">
    <MudButton OnClick="() => ShowEditRuleSetDialog(null)"
               Color="Color.Primary"
               Size="Size.Small"
               Variant="Variant.Filled">
        Create Rule
    </MudButton>
    @if (_selectedRuleSets.Count > 0)
    {
        <MudButton OnClick="DeleteSelectedRuleSets"
                   Color="Color.Error"
                   Size="Size.Small"
                   Variant="Variant.Filled">
            Delete @_selectedRuleSets.Count Selected
        </MudButton>
    }
</MudStack>

<!-- Rules listing -->
<MudDataGrid T="RuleSetViewModel"
             Items="@_dataContext.RuleSets"
             SelectedItemsChanged="RuleSet_SelectionChanged"
             Dense="true"
             EditMode="DataGridEditMode.Form"
             Filterable="true"
             FilterMode="DataGridFilterMode.ColumnFilterMenu"
             FixedHeader="true"
             Hover="true"
             MultiSelection="true"
             ReadOnly="true"
             SortMode="SortMode.Multiple">
    <Columns>

        <!-- Selection CheckBox -->
        <SelectColumn T="RuleSetViewModel"/>

        <!-- Priority -->
        <PropertyColumn Property="x => x.Priority"/>

        <!-- Name -->
        <PropertyColumn Property="x => x.Name"/>

        <!-- Target Bucket -->
        <PropertyColumn Property="x => x.TargetBucket.Name"
                        Title="Target Bucket">
            <CellTemplate>
                <MudPaper Class="d-flex align-center justify-center mud-width-full bucket-indicator no-background"
                          Style="@($"background-color: {ColorTranslator.ToHtml(context.Item.TargetBucket.Color)}; color: {ColorTranslator.ToHtml(context.Item.TargetBucket.TextColor)}")">
                    <MudText>@context.Item.TargetBucket.Name</MudText>
                </MudPaper>
            </CellTemplate>
            <FilterTemplate>
                <MudGrid Spacing="6"
                         Style="width:430px">
                    <MudItem xs="12">
                        <MudSelect T="BucketViewModel"
                                   @bind-SelectedValues="_bucketMudFilter.SelectedItems"
                                   MultiSelection="true"
                                   MultiSelectionTextFunc="@(items => MultiSelectionTextHelper.GetText(items, "Buckets"))"
                                   SelectAll="true">
                            @foreach (var partialBucket in _bucketMudFilter.AvailableItems)
                            {
                                <MudSelectItem Value="partialBucket">@partialBucket</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12"
                             Class="d-flex justify-end">
                        <MudButton OnClick="@(() => _bucketMudFilter.ResetFilterOnContextAsync(context))">
                            Clear
                        </MudButton>
                        <MudButton OnClick="@(() => _bucketMudFilter.ApplyFilterOnContextAsync(context))"
                                   Color="@Color.Primary">
                            Filter
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </FilterTemplate>
        </PropertyColumn>

        <!-- Mapping Rules -->
        <PropertyColumn Property="x => x.MappingRules"
                        Comparer="@(new MudComparer())"
                        Title="Mapping Rules">
            <CellTemplate>
                <MudStack Spacing="0">
                    @foreach (var mappingRule in context.Item.MappingRules)
                    {
                        <MudText>@mappingRule.ToString()</MudText>
                    }
                </MudStack>
            </CellTemplate>
            <FilterTemplate>
                <MudGrid Spacing="6"
                         Style="width:430px">
                    <MudItem xs="12">
                        <MudSelect T="MappingRuleComparisonField"
                                   @bind-Value="_mappingRuleMudFilter.SelectedComparisonField"
                                   Label="Comparision Field">
                            @foreach (var comparisonField in _mappingRuleMudFilter.AvailableComparisonFields)
                            {
                                <MudSelectItem Value="comparisonField">@comparisonField</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_mappingRuleMudFilter.ComparisionValue"
                                      Label="Comparison Value"/>
                    </MudItem>
                    <MudItem xs="12"
                             Class="d-flex justify-end">
                        <MudButton OnClick="@(() => _mappingRuleMudFilter.ResetFilterOnContextAsync(context))">
                            Clear
                        </MudButton>
                        <MudButton OnClick="@(() => _mappingRuleMudFilter.ApplyFilterOnContextAsync(context))"
                                   Color="@Color.Primary">
                            Filter
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </FilterTemplate>
        </PropertyColumn>

        <!-- Rule Action Buttons -->
        <TemplateColumn>
            <CellTemplate>
                <MudStack AlignItems="AlignItems.End">
                    <MudIconButton OnClick="() => ShowEditRuleSetDialog(context.Item)"
                                   Icon="@Icons.Material.Outlined.Edit"
                                   Size="@Size.Small"/>
                </MudStack>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
</MudDataGrid>
