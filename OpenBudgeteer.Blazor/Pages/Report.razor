@page "/report"
@using ApexCharts
@using OpenBudgeteer.Blazor.Common
@using OpenBudgeteer.Blazor.Common.Extensions
@using Align = MudBlazor.Align

<MudTabs Elevation="2" Rounded PanelClass="pa-4">
    <MudTabPanel Text="General">
        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudPaper Elevation="2" Class="pt-2 px-2">
                    <MudText Typo="Typo.h5" Align="Align.Center">Month Balances</MudText>
                    <ApexChart
                        @ref="_monthBalanceChart"
                        TItem="ApexRecord"
                        Options="@(new ApexChartOptions<ApexRecord> { Theme = BaseTheme })">
                        <ApexPointSeries
                            TItem="ApexRecord"
                            Items="_dataContext.MonthBalances"
                            Name="Balance"
                            SeriesType="SeriesType.Bar"
                            XValue="i => i.Label"
                            YValue="i => i.Value"
                            DataPointMutator="ApexHelper.BalanceChartMutator"/>
                    </ApexChart>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudPaper Elevation="2" Class="pt-2 px-2">
                    <MudText Typo="Typo.h5" Align="Align.Center">Bank Balances</MudText>
                    <ApexChart
                        @ref="_bankBalanceChart"
                        TItem="ApexRecord"
                        Options="@(new ApexChartOptions<ApexRecord> { Theme = BaseTheme })">
                        <ApexPointSeries
                            TItem="ApexRecord"
                            Items="_dataContext.BankBalances"
                            Name="Balance"
                            SeriesType="SeriesType.Area"
                            XValue="i => i.Label"
                            YValue="i => i.Value"
                            Color=@System.Drawing.Color.Green.ToHexString()/>
                    </ApexChart>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudPaper Elevation="2" Class="pt-2 px-2">
                    <MudText Typo="Typo.h5" Align="Align.Center">Income & Expenses per Month</MudText>
                    <ApexChart
                        @ref="_monthIncomeExpensesChart"
                        TItem="ApexRecord"
                        Options="@(new ApexChartOptions<ApexRecord> { Theme = BaseTheme, Legend = NoLegend })">
                        <ApexPointSeries
                            TItem="ApexRecord"
                            Items="_dataContext.MonthIncome"
                            Name="Income"
                            SeriesType="SeriesType.Bar"
                            XValue="i => i.Label"
                            YValue="i => i.Value"
                            Color=@System.Drawing.Color.Green.ToHexString()/>
                        <ApexPointSeries
                            TItem="ApexRecord"
                            Items="_dataContext.MonthExpenses"
                            Name="Expenses"
                            SeriesType="SeriesType.Bar"
                            XValue="i => i.Label"
                            YValue="i => i.Value"
                            Color=@System.Drawing.Color.DarkRed.ToHexString()/>
                    </ApexChart>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudPaper Elevation="2" Class="pt-2 px-2">
                    <MudText Typo="Typo.h5" Align="Align.Center">Income & Expenses per Year</MudText>
                    <ApexChart
                        @ref="_yearIncomeExpensesChart"
                        TItem="ApexRecord"
                        Options="@(new ApexChartOptions<ApexRecord> { Theme = BaseTheme, Legend = NoLegend })">
                        <ApexPointSeries
                            TItem="ApexRecord"
                            Items="_dataContext.YearIncome"
                            Name="Income"
                            SeriesType="SeriesType.Bar"
                            XValue="i => i.Label"
                            YValue="i => i.Value"
                            Color=@System.Drawing.Color.Green.ToHexString()/>
                        <ApexPointSeries
                            TItem="ApexRecord"
                            Items="_dataContext.YearExpenses"
                            Name="Expenses"
                            SeriesType="SeriesType.Bar"
                            XValue="i => i.Label"
                            YValue="i => i.Value"
                            Color=@System.Drawing.Color.DarkRed.ToHexString()/>
                    </ApexChart>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudTabPanel>
    <MudTabPanel Text="Buckets">
        <MudGrid>
            <MudItem xs="12">
                <MudStack Row Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                    <MudSpacer/>
                    <YearMonthSelector DataContext="YearMonthDataContext"/>
                </MudStack>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudPaper Elevation="2" Class="pt-2 px-2">
                    <MudText Typo="Typo.h5" Align="Align.Center">Balance per Bucket Group</MudText>
                    <ApexChart
                        @ref="_balanceDistributionBucketGroupChart"
                        TItem="ApexRecord"
                        Options="@(new ApexChartOptions<ApexRecord> { Theme = BaseTheme, Legend = NoLegend, PlotOptions = DonutPlot })">
                        <ApexPointSeries
                            TItem="ApexRecord"
                            Items="_dataContext.BalanceDistributionBucketGroup"
                            Name="Balance"
                            SeriesType="SeriesType.Donut"
                            XValue="i => i.Label"
                            YValue="i => i.Value"
                            OrderByDescending="i => i.Y"
                            ShowDataLabels/>
                    </ApexChart>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudPaper Elevation="2" Class="pt-2 px-2">
                    <MudText Typo="Typo.h5" Align="Align.Center">Balance per Bucket</MudText>
                    <ApexChart
                        @ref="_balanceDistributionBucketChart"
                        TItem="ApexRecord"
                        Options="@(new ApexChartOptions<ApexRecord> { Theme = BaseTheme, Legend = NoLegend, PlotOptions = DonutPlot })">
                        <ApexPointSeries
                            TItem="ApexRecord"
                            Items="_dataContext.BalanceDistributionBucket"
                            Name="Balance"
                            SeriesType="SeriesType.Donut"
                            XValue="i => i.Label"
                            YValue="i => i.Value"
                            OrderByDescending="i => i.Y"
                            ShowDataLabels/>
                    </ApexChart>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudPaper Elevation="2" Class="pt-2 px-2">
                    <MudText Typo="Typo.h5" Align="Align.Center">In per Bucket Group</MudText>
                    <ApexChart
                        @ref="_inDistributionBucketGroupChart"
                        TItem="ApexRecord"
                        Options="@(new ApexChartOptions<ApexRecord> { Theme = BaseTheme, Legend = NoLegend, PlotOptions = DonutPlot })">
                        <ApexPointSeries
                            TItem="ApexRecord"
                            Items="_dataContext.InDistributionBucketGroup"
                            Name="In"
                            SeriesType="SeriesType.Donut"
                            XValue="i => i.Label"
                            YValue="i => i.Value"
                            OrderByDescending="i => i.Y"
                            ShowDataLabels/>
                    </ApexChart>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudPaper Elevation="2" Class="pt-2 px-2">
                    <MudText Typo="Typo.h5" Align="Align.Center">In per Bucket</MudText>
                    <ApexChart
                        @ref="_inDistributionBucketChart"
                        TItem="ApexRecord"
                        Options="@(new ApexChartOptions<ApexRecord> { Theme = BaseTheme, Legend = NoLegend, PlotOptions = DonutPlot })">
                        <ApexPointSeries
                            TItem="ApexRecord"
                            Items="_dataContext.InDistributionBucket"
                            Name="In"
                            SeriesType="SeriesType.Donut"
                            XValue="i => i.Label"
                            YValue="i => i.Value"
                            OrderByDescending="i => i.Y"
                            ShowDataLabels/>
                    </ApexChart>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudPaper Elevation="2" Class="pt-2 px-2">
                    <MudText Typo="Typo.h5" Align="Align.Center">Activity per Bucket Group</MudText>
                    <ApexChart
                        @ref="_activityDistributionBucketGroupChart"
                        TItem="ApexRecord"
                        Options="@(new ApexChartOptions<ApexRecord> { Theme = BaseTheme, Legend = NoLegend, PlotOptions = DonutPlot })">
                        <ApexPointSeries
                            TItem="ApexRecord"
                            Items="_dataContext.ActivityDistributionBucketGroup"
                            Name="Activity"
                            SeriesType="SeriesType.Donut"
                            XValue="i => i.Label"
                            YValue="i => i.Value"
                            OrderByDescending="i => i.Y"
                            ShowDataLabels/>
                    </ApexChart>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudPaper Elevation="2" Class="pt-2 px-2">
                    <MudText Typo="Typo.h5" Align="Align.Center">Activity per Bucket</MudText>
                    <ApexChart
                        @ref="_activityDistributionBucketChart"
                        TItem="ApexRecord"
                        Options="@(new ApexChartOptions<ApexRecord> { Theme = BaseTheme, Legend = NoLegend, PlotOptions = DonutPlot })">
                        <ApexPointSeries
                            TItem="ApexRecord"
                            Items="_dataContext.ActivityDistributionBucket"
                            Name="Activity"
                            SeriesType="SeriesType.Donut"
                            XValue="i => i.Label"
                            YValue="i => i.Value"
                            OrderByDescending="i => i.Y"
                            ShowDataLabels/>
                    </ApexChart>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudTabPanel>
    <MudTabPanel Text="Bucket Budgets">
        <MudStack Row Spacing="2" Class="mb-4" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudSpacer/>
            <YearMonthSelector DataContext="YearMonthDataContext"/>
        </MudStack>
        <MudExpansionPanels>
            @foreach (var bucketGroup in _dataContext.BucketGroupsBucketBudgets)
            {
                <MudExpansionPanel Text="@bucketGroup.Name">
                    <MudGrid Class="mt-n5"> @*Default is "mt-n6" but hides top border of below MudPaper*@
                        @foreach (var bucketReportRecord in bucketGroup.Buckets)
                        {
                            <MudItem xs="12" sm="4">
                                <MudPaper Elevation="2" Class="pt-2 px-2 overflow-hidden" Height="270px">
                                    <ApexChart
                                        @ref="InjectBucketRemainingBudgetChart"
                                        Title="@bucketReportRecord.Name"
                                        TItem="ApexRecord"
                                        Options="GaugeChartOptions">
                                        <ApexPointSeries
                                            TItem="ApexRecord"
                                            Items="@bucketReportRecord.Records"
                                            SeriesType="SeriesType.RadialBar"
                                            XValue="i => i.Label"
                                            YValue="i => i.Value"/>
                                    </ApexChart>
                                </MudPaper>
                            </MudItem>
                        }
                    </MudGrid>
                </MudExpansionPanel>
            }
        </MudExpansionPanels>
        <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
            <MudStack>
                <MudText Typo="Typo.body2">This overview shows only meaningful Buckets:</MudText>
                <MudText Typo="Typo.body2">- Bucket Type: Standard Bucket or Monthly Expense</MudText>
                <MudText Typo="Typo.body2">- Buckets with zero Balance, Activity and In are excluded (assumed as "unused")</MudText>
            </MudStack>
        </MudAlert>
    </MudTabPanel>
    <MudTabPanel Text="Monthly Bucket Expenses">
        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudPaper Elevation="2" Class="pt-2 px-2">
                    <MudText Typo="Typo.h5" Align="Align.Center">Bucket Monthly Expenses</MudText>
                    @foreach (var chart in _monthBucketExpensesConfigsLeft)
                    {
                        <ApexChart
                            @ref="InjectMonthBucketExpensesChart"
                            TItem="ApexRecord"
                            Title="@chart.Item1"
                            Height="150"
                            Options="@(new ApexChartOptions<ApexRecord> { Theme = BaseTheme })">
                            <ApexPointSeries
                                TItem="ApexRecord"
                                Items="chart.Item2"
                                Name="Expenses"
                                SeriesType="SeriesType.Bar"
                                XValue="i => i.Label"
                                YValue="i => i.Value"
                                Color=@System.Drawing.Color.DarkRed.ToHexString()/>
                        </ApexChart>
                    }
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudPaper Elevation="2" Class="pt-2 px-2">
                    <MudText Typo="Typo.h5" Align="Align.Center">Bucket Monthly Expenses</MudText>
                    @foreach (var chart in _monthBucketExpensesConfigsRight)
                    {
                        <ApexChart
                            @ref="InjectMonthBucketExpensesChart"
                            TItem="ApexRecord"
                            Title="@chart.Item1"
                            Height="150"
                            Options="@(new ApexChartOptions<ApexRecord> { Theme = BaseTheme })">
                            <ApexPointSeries
                                TItem="ApexRecord"
                                Items="chart.Item2"
                                Name="Expenses"
                                SeriesType="SeriesType.Bar"
                                XValue="i => i.Label"
                                YValue="i => i.Value"
                                Color=@System.Drawing.Color.DarkRed.ToHexString()/>
                        </ApexChart>
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudTabPanel>
</MudTabs>
