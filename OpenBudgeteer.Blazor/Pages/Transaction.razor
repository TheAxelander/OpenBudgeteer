@page "/transaction"
@attribute [Authorize]
@using System.Drawing
@using System.Globalization
@using OpenBudgeteer.Blazor.Common
@using OpenBudgeteer.Core.ViewModels.EntityViewModels
@using Color = MudBlazor.Color
@using Size = MudBlazor.Size

<!-- Action Buttons -->
<MudStack AlignItems="AlignItems.Center"
          Class="mb-2"
          Row
          Spacing="2"
          Wrap="Wrap.Wrap">
    @if (_isEditModeEnabled)
    {
        <!-- Action Buttons (Edit Mode) -->
        <MudButton OnClick="SaveAllTransaction"
                   Color="Color.Primary"
                   Size="Size.Small"
                   Variant="Variant.Filled">
            Save all
        </MudButton>
        <MudButton OnClick="CancelAllTransaction"
                   Color="Color.Error"
                   Size="Size.Small"
                   Variant="Variant.Filled">
            Cancel all
        </MudButton>
    }
    else
    {
        <!-- Action Buttons (Default Mode) -->
        <MudButtonGroup Color="Color.Primary"
                        Size="Size.Small"
                        Variant="Variant.Filled">
            <MudButton OnClick="ShowCreateTransactionDialog"
                       Class="restore-size-small">
                Create Transaction
            </MudButton>
            <MudMenu Icon="@Icons.Material.Filled.ArrowDropDown"
                     Style="align-self: auto;">
                <MudMenuItem OnClick="ShowCreateTransferDialog">
                    Create Transfer
                </MudMenuItem>
            </MudMenu>
        </MudButtonGroup>
        <MudButton OnClick="SwitchToEditMode"
                   Color="Color.Primary"
                   Size="Size.Small"
                   Variant="Variant.Filled">
            Edit @(_selectedTransactions.Count == 0 ? "all" : $"{_selectedTransactions.Count} Selected")
        </MudButton>
        @if (_selectedTransactions.Count > 0)
        {
            <MudButton OnClick="DeleteSelectedTransactions"
                       Color="Color.Error"
                       Size="Size.Small"
                       Variant="Variant.Filled">
                Delete @_selectedTransactions.Count Selected
            </MudButton>
        }
        <MudButton OnClick="ProposeBucketsAsync"
                   Color="Color.Primary"
                   Size="Size.Small"
                   Variant="Variant.Filled">
            Propose Buckets
        </MudButton>
        <MudButtonGroup Color="Color.Primary"
                        Size="Size.Small"
                        Variant="Variant.Filled">
            <MudButton OnClick="AddRecurringTransactions"
                       Class="restore-size-small">
                Add Recurring Transactions
            </MudButton>
            <MudMenu Icon="@Icons.Material.Filled.ArrowDropDown"
                     Style="align-self: auto;">
                <MudMenuItem OnClick="ShowRecurringTransactionDialog">
                    Manage Recurring Transactions
                </MudMenuItem>
            </MudMenu>
        </MudButtonGroup>
        <MudSpacer/>
        <MudTooltip RootClass="d-flex align-center">
            <ChildContent>
                <MudIcon Icon="@Icons.Material.Outlined.Info"/>
            </ChildContent>
            <TooltipContent>
                <MudText Style="font-weight: bold"
                         Typo="Typo.body2">
                    Press Shift + move the mouse wheel
                </MudText>
                <MudText Style="font-weight: bold"
                         Typo="Typo.body2">
                    to scroll horizontally in below table
                </MudText>
            </TooltipContent>
        </MudTooltip>
        <YearMonthSelector DataContext="YearMonthDataContext"/>
    }
</MudStack>

<!-- Transaction listing -->
<MudDataGrid T="TransactionViewModel"
             Items="@_dataContext.Transactions"
             SelectedItemsChanged="Transactions_SelectionChanged"
             Dense="true"
             EditMode="DataGridEditMode.Cell"
             Filterable="true"
             FilterMode="DataGridFilterMode.ColumnFilterMenu"
             FixedHeader="true"
             Hover="true"
             MultiSelection="true"
             QuickFilter="Transactions_QuickFilter"
             ReadOnly="@(!_isEditModeEnabled)"
             SortMode="SortMode.Multiple">
    <Columns>

        <!-- Selection CheckBox -->
        <SelectColumn T="TransactionViewModel"/>

        <!-- Date -->
        <PropertyColumn Property="x => x.TransactionDate"
                        Title="Date">
            <EditTemplate>
                <MudDatePicker DateChanged="@(time => TransactionDateChanged(time, context.Item))"
                               Date="@(context.Item.TransactionDate.ToDateTime(TimeOnly.MinValue))"
                               ShowToolbar="false"/>
            </EditTemplate>
            <FilterTemplate>
                <MudGrid Spacing="6"
                         Style="width:430px">
                    <MudItem xs="12">
                        <MudDateRangePicker @bind-DateRange="@_dateOnlyMudFilter.DateRange"
                                            Margin="Margin.Dense"
                                            PickerVariant="PickerVariant.Inline"/>
                    </MudItem>
                    <MudItem Class="d-flex justify-end"
                             xs="12">
                        <MudButton OnClick="@(() => _dateOnlyMudFilter.ResetFilterOnContextAsync(context))">
                            Clear
                        </MudButton>
                        <MudButton OnClick="@(() => _dateOnlyMudFilter.ApplyFilterOnContextAsync(context))"
                                   Color="@Color.Primary">
                            Filter
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </FilterTemplate>
        </PropertyColumn>

        <!-- Account -->
        <PropertyColumn Property="x => x.SelectedAccount"
                        Title="Account"
                        CellStyle="min-width: 150px"
                        Comparer="@(new MudComparer())">
            <EditTemplate>
                <MudSelect T="AccountViewModel"
                           @bind-Value="context.Item.SelectedAccount">
                    @foreach (var account in context.Item.AvailableAccounts)
                    {
                        <MudSelectItem Value="@account">@account.Name</MudSelectItem>
                    }
                </MudSelect>
            </EditTemplate>
            <FilterTemplate>
                <MudGrid Spacing="6"
                         Style="width:430px">
                    <MudItem xs="12">
                        <MudSelect T="AccountViewModel"
                                   @bind-SelectedValues="_accountMudFilter.SelectedItems"
                                   MultiSelection="true"
                                   MultiSelectionTextFunc="@(items => MultiSelectionTextHelper.GetText(items, "Accounts"))"
                                   SelectAll="true">
                            @foreach (var account in _accountMudFilter.AvailableItems)
                            {
                                <MudSelectItem Value="account">@account</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem Class="d-flex justify-end"
                             xs="12">
                        <MudButton OnClick="@(() => _accountMudFilter.ResetFilterOnContextAsync(context))">
                            Clear
                        </MudButton>
                        <MudButton OnClick="@(() => _accountMudFilter.ApplyFilterOnContextAsync(context))"
                                   Color="@Color.Primary">
                            Filter
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </FilterTemplate>
        </PropertyColumn>

        <!-- Payee -->
        <PropertyColumn Property="x => x.Payee"/>

        <!-- Memo -->
        <PropertyColumn Property="x => x.Memo"/>

        <!-- Amount -->
        <PropertyColumn Property="x => x.Amount"
                        CellClass="col-numbers"
                        Culture="CultureInfo.CurrentCulture"
                        Format="C">
            <EditTemplate>
                <MudNumericField T="decimal"
                                 @bind-Value="context.Item.Amount"
                                 Culture="CultureInfo.CurrentCulture"
                                 Format="N2"/>
            </EditTemplate>
        </PropertyColumn>

        <!-- Buckets -->
        <PropertyColumn Property="x => x.Buckets"
                        CellStyle="min-width: 300px"
                        Comparer="@(new MudComparer())">
            <CellTemplate>
                <MudStack Spacing="2">
                    @foreach (var bucket in context.Item.Buckets)
                    {
                        <MudStack AlignItems="AlignItems.Center"
                                  Class="px-3 bucket-indicator"
                                  Row
                                  Spacing="1"
                                  StretchItems="StretchItems.Start"
                                  Style="@($"background-color: {ColorTranslator.ToHtml(bucket.SelectedBucketColor)}; color: {ColorTranslator.ToHtml(bucket.SelectedBucketTextColor)}")">
                            <MudText>@bucket.SelectedBucketName</MudText>
                            <MudText Style="white-space: nowrap;">@bucket.Amount.ToString("C", CultureInfo.CurrentCulture)</MudText>
                        </MudStack>
                    }
                </MudStack>
            </CellTemplate>
            <EditTemplate>
                <MudStack Spacing="1">
                    @foreach (var bucket in context.Item.Buckets)
                    {
                        <MudGrid Spacing="2">
                            <MudItem Class="d-flex align-center"
                                     xs="6">
                                <MudButton OnClick="@(() => ShowBucketSelectDialog(context.Item, bucket))"
                                           Class="mud-width-full bucket-indicator"
                                           Size="Size.Small"
                                           Style="@($"background-color: {ColorTranslator.ToHtml(bucket.SelectedBucketColor)}; color: {ColorTranslator.ToHtml(bucket.SelectedBucketTextColor)}")">
                                    @bucket.SelectedBucketName
                                </MudButton>
                            </MudItem>
                            <MudItem xs="4">
                                <MudNumericField T="decimal"
                                                 @bind-Value="bucket.Amount"
                                                 Culture="CultureInfo.CurrentCulture"
                                                 Format="N2"
                                                 Style="width: 90px"/>
                            </MudItem>
                            <MudItem xs="2">
                                <MudIconButton OnClick="bucket.DeleteBucket"
                                               Icon="@Icons.Material.Outlined.Delete"
                                               Size="@Size.Small"/>
                            </MudItem>
                        </MudGrid>
                    }
                    @if (context.Item.Difference != 0)
                    {
                        <MudGrid Spacing="2">
                            <MudItem Class="d-flex align-center"
                                     xs="6">
                                <MudPaper Class="d-flex align-center justify-center mud-width-full bucket-indicator no-background"
                                          Style="background-color: deepskyblue;">
                                    <MudText>Remaining</MudText>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="4">
                                <MudText Class="align-center"
                                         Style="width: 90px">
                                    @context.Item.Difference.ToString("C", CultureInfo.CurrentCulture)
                                </MudText>
                            </MudItem>
                            <MudItem xs="2">
                            </MudItem>
                        </MudGrid>
                    }
                </MudStack>
            </EditTemplate>
            <FilterTemplate>
                <MudGrid Spacing="6"
                         Style="width:430px">
                    <MudItem xs="12">
                        <MudSelect T="PartialBucketViewModel"
                                   @bind-SelectedValues="_bucketMudFilter.SelectedItems"
                                   MultiSelection="true"
                                   MultiSelectionTextFunc="@(items => MultiSelectionTextHelper.GetText(items, "Buckets"))"
                                   SelectAll="true">
                            @foreach (var partialBucket in _bucketMudFilter.AvailableItems)
                            {
                                <MudSelectItem Value="partialBucket">@partialBucket</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem Class="d-flex justify-end"
                             xs="12">
                        <MudButton OnClick="@(() => _bucketMudFilter.ResetFilterOnContextAsync(context))">
                            Clear
                        </MudButton>
                        <MudButton OnClick="@(() => _bucketMudFilter.ApplyFilterOnContextAsync(context))"
                                   Color="@Color.Primary">
                            Filter
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </FilterTemplate>
        </PropertyColumn>
    </Columns>
</MudDataGrid>
